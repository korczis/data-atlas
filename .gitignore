node_modules/

# Mezivýsledky datového řetězu. Obsahují nefiltrovanou historii prohlížení
# včetně interních hostnames — do repozitáře nepatří za žádných okolností.
.cache/

# Postavená stránka; Pages si ji staví z committnutých CSV.
dist/

.DS_Store
*.log

# Site-specific hostnames vlastní sítě — nikdy se necommitují.
config/private-hosts.txt

# Python bytecode z tools/
__pycache__/
*.pyc

# Výstupy Playwrightu (stopy, snímky selhání). Generované, do repozitáře nepatří.
test-results/
playwright-report/

# Stažené raw artefakty warehouse subsystému. 2,8 GB, content-addressed podle
# SHA-256 a reprodukovatelné z warehouse/manifests/ — do repozitáře nepatří.
warehouse/raw/

# Lokální konfigurace warehouse. Vzor je warehouse/.env.example, který tajemství
# neobsahuje a committuje se.
warehouse/.env

# Python venv, pokud si ho někdo vytvoří vedle balíčku.
warehouse/.venv/

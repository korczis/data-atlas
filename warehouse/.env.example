# warehouse/.env.example — copy to .env and edit. NEVER commit .env.
#
# Nothing in this subsystem has a default password, and no connection string is
# committed anywhere in this repository. This file documents the shape of what
# the tooling reads from the environment; it contains no secrets and is safe to
# commit as-is.

# ── database ─────────────────────────────────────────────────────────────────
# ATLAS_DATABASE_URL wins when both are set, so this subsystem can be pointed at
# its own database without disturbing another tool already using DATABASE_URL in
# the same shell.
#
# Local socket (no password on disk — preferred for development):
ATLAS_DATABASE_URL=postgresql:///atlas_data
#
# Local TCP:
# ATLAS_DATABASE_URL=postgresql://localhost:5432/atlas_data
#
# With credentials. Put a real password in ~/.pgpass (mode 0600) rather than
# here, so it never reaches a shell history or a process listing:
# ATLAS_DATABASE_URL=postgresql://atlas_owner@db.example.org:5432/atlas_data

# ── raw artifact storage ─────────────────────────────────────────────────────
# Where downloaded artifacts live. Content-addressed as <sha256>/<filename>.
# Defaults to warehouse/raw/, which is gitignored. Point it at another volume if
# the corpus (2.8 GB compressed) should not live inside the repository.
# ATLAS_RAW_DIR=/Volumes/archive/atlas-raw

# ── network manners ──────────────────────────────────────────────────────────
# Sent on every request. Identify yourself and give a way to be contacted; a
# crawler that says nothing about itself deserves to be blocked.
# ATLAS_USER_AGENT=data-atlas-warehouse/0.1 (+https://example.org/contact)
